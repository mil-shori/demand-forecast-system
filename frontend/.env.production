# Production Environment Variables for Demand Forecast Frontend
# 需要予測システム 本番環境設定
# Warning: この設定は本番環境でのみ使用してください

# API Configuration
VITE_API_BASE_URL=https://api.demand-forecast.example.com
VITE_API_TIMEOUT=15000

# Application Configuration
VITE_APP_NAME=需要予測システム
VITE_APP_VERSION=$npm_package_version
VITE_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_DEBUG_MODE=false

# Authentication Settings
VITE_AUTH_TOKEN_KEY=demand_forecast_token_prod
VITE_AUTH_REFRESH_TOKEN_KEY=demand_forecast_refresh_token_prod
VITE_SESSION_TIMEOUT=28800000

# UI/UX Settings
VITE_DEFAULT_LANGUAGE=ja
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_DEFAULT_PAGE_SIZE=20

# Chart & Data Visualization
VITE_CHART_ANIMATION_DURATION=500
VITE_MAX_CHART_DATA_POINTS=2000
VITE_DEFAULT_CHART_COLORS=["#3b82f6", "#ef4444", "#10b981", "#f59e0b", "#8b5cf6"]

# File Upload Settings
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=["text/csv", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]

# Business Logic Settings
VITE_DEFAULT_FORECAST_HORIZON=28
VITE_MAX_FORECAST_HORIZON=365
VITE_DEFAULT_SERVICE_LEVEL=0.95

# External Services
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://xxxxxxxxxx@sentry.io/xxxxxxx

# Production Settings
VITE_MOCK_API=false
VITE_SHOW_DEV_TOOLS=false