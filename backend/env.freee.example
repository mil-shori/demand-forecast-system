# freee会計API連携用の環境変数サンプル
# 使い方: この内容を backend/.env に追記（または新規作成）してください。.env は .gitignore 済みです。
#
# 1. freee開発者アカウント（https://developer.freee.co.jp/）でアプリを作成し、
#    Client ID / Client Secret を取得してください。
# 2. アプリのコールバックURLに以下を登録してください:
#    http://localhost:8000/api/v1/accounting/freee/callback

FREEE_CLIENT_ID=your-freee-client-id
FREEE_CLIENT_SECRET=your-freee-client-secret
FREEE_REDIRECT_URI=http://localhost:8000/api/v1/accounting/freee/callback

# トークン暗号化キー（Fernet形式）。以下のコマンドで生成してください:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# コールバック後にリダイレクトするフロントエンドのURL
FRONTEND_BASE_URL=http://localhost:3000

# --- AI機能（Claude API）---
# 勘定科目のAI推定・月次レポートのAIサマリー生成に使用します。
# https://platform.claude.com/ でAPIキーを取得してください。未設定の場合はAI機能のみ無効になります。
ANTHROPIC_API_KEY=
# 使用モデル（省略時: claude-opus-4-8）
# ANTHROPIC_MODEL=claude-opus-4-8
