# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/demand_forecast
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/demand_forecast_test

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Data Encryption
DATA_ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Monitoring & Logging
SENTRY_DSN=
LOG_LEVEL=INFO

# External APIs (if any)
# API_KEY_EXTERNAL_SERVICE=

# Email Configuration (for alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Forecast Settings
FORECAST_DEFAULT_HORIZON=28  # days
MAX_FORECAST_HORIZON=365     # days
FORECAST_BATCH_SIZE=100      # SKUs per batch

# Business Settings
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=7